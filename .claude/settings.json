{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./gradlew spotlessApply"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./gradlew build"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(gh pr create *)",
        "hooks": [
          {
            "type": "command",
            "command": "./gradlew clean build"
          }
        ]
      }
    ]
  }
}