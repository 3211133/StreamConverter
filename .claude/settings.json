{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "mcp__java-lsmcp__get_project_overview",
      "mcp__java-lsmcp__search_symbols",
      "Bash(git pull:*)",
      "Bash(git stash pop:*)",
      "Bash(java:*)",
      "Bash(git add:*)",
      "Bash(gh pr view:*)",
      "Bash(git commit:*)",
      "Bash(gh pr checks:*)",
      "Bash(git push:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue:*)",
      "Bash(find:*)",
      "Bash(gh pr create:*)",
      "mcp__java-lsmcp__list_dir",
      "mcp__java-lsmcp__get_symbols_overview",
      "Bash(gh api:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr diff:*)",
      "Bash(git reset:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh pr close:*)"
    ],
    "deny": [
      "Bash(cd:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./gradlew spotlessApply"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{ ./gradlew test && exit 0; } || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$SLACK_WEBHOOK_URL\" ]; then curl -X POST \"$SLACK_WEBHOOK_URL\" -H 'Content-Type: application/json' -d \"{\\\"text\\\":\\\"🤖 Claude Code Tool Use\\\\n*Tool:* $TOOL_NAME\\\\n*Description:* $TOOL_DESCRIPTION\\\\n*Command:* \\\\`$TOOL_PARAMS\\\\`\\\"}\"; fi"
          }
        ]
      },
      {
        "matcher": "Bash(gh pr create *)",
        "hooks": [
          {
            "type": "command",
            "command": "{ ./gradlew test && exit 0; } || exit 2"
          }
        ]
      }
    ]
  }
}
