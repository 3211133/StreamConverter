# Git and version control
.git
.gitignore
*.md
CHANGELOG*

# Build artifacts
**/build/
**/target/
**/*.jar
**/*.war
**/*.ear

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
*.pid

# Test coverage and reports
**/coverage/
**/reports/
**/.nyc_output/

# Node.js (if any frontend components)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Local development
.env
.env.local
.env.*.local

# Gradle wrapper jar (will be copied explicitly)
!gradle/wrapper/gradle-wrapper.jar

# Documentation (keep only essential docs)
docs/
*.pdf

# Large test data files
**/test-data/
**/*-large.*
**/*-5gb.*

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile

# Security files
*.pem
*.key
*.crt
*.p12
*.jks