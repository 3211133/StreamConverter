+
+    String xmlData =
+        """
+        <?xml version="1.0"?>
+        <users>
+          <user>
+            <name>John</name>
+            <age>30</age>
+            <city>NYC</city>
+          </user>
+          <user>
+            <name>Jane</name>
+            <age>25</age>
+            <city>LA</city>
+          </user>
+        </users>
