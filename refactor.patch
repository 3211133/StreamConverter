+  void testConstructor() {
+    // コンストラクタのテスト
+    ValidateCommand command = new ValidateCommand(schemaPath);
+    assertNotNull(command);
+  }
+
+  @Test
+  @DisplayName("execute正常系：有効なXML")
+  void testExecuteWithValidXml() throws IOException {
+    // 正常系のexecuteメソッドテスト
+    ValidateCommand command = new ValidateCommand(schemaPath);
