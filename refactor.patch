+      if (lines.length > 10) {
+        System.out.println("... (" + (lines.length - 10) + " more lines)");
+      }
+    }
+
+    System.out.println("\n" + "=".repeat(60) + "\n");
+  }
+
+  /** Demonstrates error handling and recovery */
+  private static void demonstrateErrorHandling() throws IOException {
