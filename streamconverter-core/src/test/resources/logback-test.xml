<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Test-only logging configuration for core module -->

    <!-- TurboFilter to automatically sync MDCContext to MDC on every log event -->
    <turboFilter class="com.streamconverter.logging.MDCTurboFilter"/>

    <!-- Console appender for immediate feedback in tests -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36}.%method:%line [execId:%X{executionId:-}, seq:%X{commandSequence:-}, userId:%X{userId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Simple rolling file appender (writes under build/test-logs by default) -->
    <property name="TEST_LOG_DIR" value="build/test-logs"/>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${TEST_LOG_DIR}/core-tests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${TEST_LOG_DIR}/core-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>5MB</maxFileSize>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36}.%method:%line [execId:%X{executionId:-}, seq:%X{commandSequence:-}, stage:%X{stage:-}, userId:%X{userId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Allow override via -Dlog.level.root=DEBUG etc. during test runs -->
    <property name="ROOT_LEVEL" value="${log.level.root:-WARN}"/>
    <property name="APP_LEVEL" value="${log.level.com.streamConverter:-WARN}"/>

    <!-- Suppress noisy info logs from XML parsers during tests (warnings still shown) -->
    <logger name="javax.xml" level="WARN"/>
    <logger name="org.xml.sax" level="WARN"/>
    <logger name="java.xml" level="WARN"/>
    <logger name="com.sun.org.apache.xerces" level="WARN"/>

    <logger name="com.streamConverter" level="${APP_LEVEL}"/>

    <root level="${ROOT_LEVEL}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>

